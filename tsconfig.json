{
  "compilerOptions": {
    "alwaysStrict": true,
    "noEmitOnError": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "dist",
    "removeComments": false,
    "rootDir": "src",
    "lib": ["dom", "es2016"],
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "target": "es6"
  },
  "include": [ "src" ],
  "exclude": [ "node_modules", ".vscode" ]
}
